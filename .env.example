# Shared MongoDB connection used by the trading lab and daily lesson archive.
MONGODB_URI=

# Contact form email transport.
EMAIL_USER=
EMAIL_PASS=
LEARNING_NOTIFICATION_EMAIL=

# Optional AI article generation. Curated evidence-first content remains usable.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Optional web discovery and higher GitHub API limits.
TAVILY_API_KEY=
GITHUB_TOKEN=

# Private owner workspace. Use two different long random values in production.
LEARNING_ACCESS_KEY=
LEARNING_SESSION_SECRET=

# Set to true to bypass authentication and access learning workspace directly.
LEARNING_AUTH_DISABLED=false

# Protects the Vercel Cron endpoint. Use a long random value in production.
CRON_SECRET=
